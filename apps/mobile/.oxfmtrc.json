{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "insertFinalNewline": true,
  "sortImports": { "enabled": true },
  "sortTailwindcss": { "enabled": true },
  "sortPackageJson": { "enabled": true },
  "ignorePatterns": [
    ".expo",
    ".github",
    "babel.config.js",
    "build",
    "coverage",
    "dist",
    "node_modules",
    "schema.graphql",
    "__generated__",
    "uniwind-env.d.ts",
    "uniwind-types.d.ts"
  ]
}
