{
  "name": "@hccnj/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "src/entry.tsx",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild:release": "bun --no-env-file ./scripts/local-release.ts prebuild --clean",
    "ios:release": "bun --no-env-file ./scripts/local-release.ts run:ios --configuration Release",
    "android:release": "bun --no-env-file ./scripts/local-release.ts run:android --variant release",
    "android:bundle": "bun --no-env-file ./scripts/local-release.ts --gradle bundleRelease",
    "web": "expo start --web",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "effect-language-service patch",
    "dev": "APP_VARIANT=development expo start --ios",
    "dev:hub": "expo-device-hub",
    "dev:android": "expo start --android",
    "dev:web": "EXPO_PUBLIC_WEBSITE=true expo start --web --port 3000",
    "theme:generate": "bun scripts/generate-theme-css.ts",
    "build:tailwind": "echo 'Tailwind CSS is now handled by UniWind metro plugin'",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint -c oxlint.config.mjs && bun scripts/lint-ratchet.ts",
    "lint:fix": "oxlint -c oxlint.config.mjs --fix",
    "lint:ratchet:update": "bun scripts/lint-ratchet.ts --update",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "effect:patch": "effect-language-service patch",
    "check": "bun run typecheck && bun run lint && bun run fmt:check && bun run test",
    "generate--android-native-build": "bun --no-env-file ./scripts/generate-android-native-build.ts",
    "relay": "relay-compiler",
    "doctor": "npx react-doctor@latest",
    "version:bump": "bun --no-env-file ./scripts/version.ts",
    "codegen": "relay-compiler",
    "dev:all": "bun run scripts/dev.mjs",
    "test:native:fonts": "node scripts/test-font-registry.mjs"
  },
  "dependencies": {
    "@effect/atom-react": "4.0.5",
    "@expo-google-fonts/work-sans": "^0.4.2",
    "@expo/metro-runtime": "~58.0.16",
    "@expo/vector-icons": "^15.1.1",
    "@hccnj/schema": "workspace:*",
    "@legendapp/list": "3.6.0",
    "@legendapp/state": "^3.0.0-beta.47",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-firebase/analytics": "^27.1.0",
    "@react-native-firebase/app": "^27.1.0",
    "@react-native-firebase/app-check": "^27.1.0",
    "@react-native-firebase/auth": "^27.1.0",
    "@react-native-firebase/firestore": "^27.1.0",
    "@react-native-firebase/messaging": "^27.1.0",
    "@react-native-firebase/storage": "^27.1.0",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "@rn-primitives/slot": "^1.5.2",
    "@sentry/react-native": "~8.31.0",
    "@statsig/client-core": "3.33.5",
    "@statsig/expo-bindings": "^3.33.5",
    "class-variance-authority": "^0.7.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "effect": "catalog:",
    "expo": "~58.0.22",
    "expo-apple-authentication": "~58.0.2",
    "expo-application": "~58.1.2",
    "expo-asset": "~58.0.19",
    "expo-blur": "~58.0.5",
    "expo-build-properties": "~58.0.12",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.18",
    "expo-device": "~58.0.5",
    "expo-device-hub": "^0.10.1",
    "expo-file-system": "~58.0.13",
    "expo-font": "58.0.11",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.15",
    "expo-notifications": "~58.1.7",
    "expo-router": "58.0.28",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.21",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.20",
    "expo-web-browser": "~58.0.7",
    "fast-deep-equal": "^3.1.3",
    "graphql": "^17.0.2",
    "jotai": "^3.0.1",
    "lottie-react-native": "~7.5.0",
    "pressto": "^0.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-error-boundary": "^6.1.6",
    "react-hook-form": "^7.90.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-reanimated": "4.7.1",
    "react-native-reanimated-carousel": "^5.2.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "4.30.0",
    "react-native-svg": "^15.16.0",
    "react-native-web": "0.21.4",
    "react-native-web-webview": "^1.0.2",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "react-native-youtube-iframe": "^2.4.1",
    "react-relay": "^21.0.1",
    "relay-runtime": "^21.0.1",
    "sonner-native": "^0.27.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "uniwind": "^1.13.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@effect/language-service": "0.87.5",
    "@effect/vitest": "4.0.5",
    "@expo/config-types": "^58.0.3",
    "@expo/env": "~2.5.3",
    "@hccnj/anti-slop": "workspace:*",
    "@hccnj/config": "workspace:*",
    "@hccnj/mobile-lint": "workspace:*",
    "@shadcn/lint": "0.2.1",
    "@types/react": "~19.3.0",
    "@types/react-test-renderer": "19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "babel-plugin-relay": "21.0.1",
    "babel-preset-expo": "58.0.23",
    "oxfmt": "^0.73.0",
    "oxlint": "catalog:",
    "oxlint-config-universe": "0.2.0",
    "oxlint-tsgolint": "catalog:",
    "react-doctor": "^0.9.18",
    "react-test-renderer": "19.3.0",
    "relay-compiler": "21.0.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "expo": {
    "install": {
      "exclude": [
        "@sentry/react-native"
      ]
    }
  },
  "reanimated": {
    "staticFeatureFlags": {
      "IOS_SYNCHRONOUSLY_UPDATE_UI_PROPS": true
    }
  }
}
