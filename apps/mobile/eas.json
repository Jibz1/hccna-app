{
  "cli": {
    "version": ">= 24.12.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "environment": "development",
      "channel": "development",
      "distribution": "internal",
      "developmentClient": true
    },
    "development-simulator": {
      "environment": "development",
      "channel": "development",
      "distribution": "internal",
      "ios": {
        "simulator": true,
        "image": "latest"
      },
      "android": {
        "buildType": "apk",
        "image": "latest"
      },
      "developmentClient": true
    },
    "ios-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "environment": "preview",
      "channel": "preview",
      "distribution": "internal"
    },
    "production": {
      "environment": "production",
      "channel": "production",
      "autoIncrement": true,
      "android": {
        "image": "latest"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
