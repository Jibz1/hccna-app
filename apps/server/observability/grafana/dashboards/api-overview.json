{
	"title": "HCCNA Backend API Overview",
	"tags": ["hccna", "backend", "slo"],
	"timezone": "browser",
	"schemaVersion": 39,
	"version": 1,
	"refresh": "30s",
	"templating": {
		"list": [
			{
				"name": "datasource",
				"type": "datasource",
				"query": "prometheus",
				"current": {
					"text": "grafanacloud-hccna-prom",
					"value": "grafanacloud-prom"
				},
				"hide": 0
			},
			{
				"name": "job",
				"label": "Job",
				"type": "query",
				"datasource": {
					"type": "prometheus",
					"uid": "${datasource}"
				},
				"definition": "label_values(http_server_request_duration_seconds_count, job)",
				"query": {
					"query": "label_values(http_server_request_duration_seconds_count, job)",
					"refId": "job"
				},
				"refresh": 2,
				"sort": 1,
				"includeAll": true,
				"allValue": ".*",
				"multi": false,
				"current": {
					"text": "railway/hccna-backend-railway",
					"value": "railway/hccna-backend-railway"
				},
				"hide": 0
			}
		]
	},
	"panels": [
		{
			"id": 1,
			"title": "API Availability (5m)",
			"type": "timeseries",
			"targets": [
				{
					"expr": "100 * (1 - ((sum(rate(http_server_errors_total{job=~\"$job\"}[5m])) / (sum(rate(http_server_request_duration_seconds_count{job=~\"$job\"}[5m])) > 0)) or 0 * sum(rate(http_server_request_duration_seconds_count{job=~\"$job\"}[5m]))))",
					"legendFormat": "availability %"
				}
			],
			"datasource": {
				"type": "prometheus",
				"uid": "${datasource}"
			}
		},
		{
			"id": 2,
			"title": "REST p95 Latency",
			"type": "timeseries",
			"targets": [
				{
					"expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{job=~\"$job\", path_group!~\"/graphql.*\"}[5m])))",
					"legendFormat": "rest p95"
				}
			],
			"datasource": {
				"type": "prometheus",
				"uid": "${datasource}"
			}
		},
		{
			"id": 3,
			"title": "GraphQL p95 Latency",
			"type": "timeseries",
			"targets": [
				{
					"expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{job=~\"$job\", path_group=~\"/graphql.*\"}[5m])))",
					"legendFormat": "graphql p95"
				}
			],
			"datasource": {
				"type": "prometheus",
				"uid": "${datasource}"
			}
		},
		{
			"id": 4,
			"title": "Force-Sampled Events",
			"type": "timeseries",
			"targets": [
				{
					"expr": "sum by (reason) (rate(telemetry_forced_sample_total{job=~\"$job\"}[5m]))",
					"legendFormat": "{{reason}}"
				}
			],
			"datasource": {
				"type": "prometheus",
				"uid": "${datasource}"
			}
		}
	]
}
