# Database (PostgreSQL)
# For local development:
DATABASE_URL="postgresql://postgres:password@localhost:5432/postgres"
DB_CONNECTION_TIMEOUT_MS=
DB_POOL_MAX=

CCB_PASSWORD="your_ccb_password"
CCB_USERNAME="your_ccb_username"
CCB_API_END_POINT="your_ccb_api_endpoint"

REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
REDIS_USERNAME=
MEILISEARCH_HOST=
MEILISEARCH_API_KEY=
PORT=
CASTR_PW=
CASTR_USR=
CASTR_API_END_POINT=
SENDGRID_API_KEY=
STATSIG_CLIENT_SDK_KEY=
STATSIG_ENVIRONMENT=
STATSIG_SERVER_SECRET_KEY=

SENTRY_ENABLED=false
# Error capture rate (default 0.8) and transaction/trace rate (default 0.1).
#SENTRY_SAMPLE_RATE=0.8
#SENTRY_TRACES_SAMPLE_RATE=0.1
#NODE_ENV="production"

OTEL_SERVICE_NAME=hccna-backend
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-us-central-0.grafana.net
OTEL_EXPORTER_OTLP_HEADERS="Authorization=Basic <base64(instanceId:apiKey)>"
CLOUD_RUN_SERVICE_URL=https://my-service-xyz.run.app

# Strapi 5 CMS: required, the server fails at startup without both (docs/secrets.md)
CMS_V5_ENDPOINT=https://cms.hccna.church/graphql
CMS_V5_TOKEN=
# Railway only: the secret the Strapi 5 CMS sends in the x-cms-webhook-secret header on
# cmsWebhookUpdate notices with cmsVersion V5 (docs/cms-change-notices.md)
# CMS_WEBHOOK_SECRET=

# Shorts feed (docs/secrets.md). Without the key the shorts query returns an empty list.
# YOUTUBE_API_KEY=
# Optional: the channel that is always in the feed (handle, channel URL or channel id).
# Defaults to the church's own channel.
# SHORTS_DEFAULT_CHANNEL=
