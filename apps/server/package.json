{
	"name": "@hccnj/server",
	"version": "0.0.0",
	"type": "module",
	"main": "src/index.ts",
	"scripts": {
		"build": "tsc -b",
		"deps:policy": "bun run scripts/check-dependency-policy.ts",
		"dev": "bun --watch ./src/index.ts",
		"start": "bun run ./src/index.ts",
		"start:container": "bun run ./scripts/docker-entrypoint.ts",
		"prettier:check": "oxfmt --check",
		"prettier:fix": "oxfmt --write",
		"lint": "bun run lint:ox",
		"lint:fix": "oxlint --fix",
		"lint:ox": "oxlint && bun run scripts/check-observability.ts && bun run scripts/validate-observability-assets.ts && bun run scripts/check-effect-boundaries.ts && bun run knip",
		"test": "bun test src/",
		"test:summary": "bun scripts/test-summary.ts",
		"validate:observability": "bun run scripts/validate-observability-assets.ts",
		"knip": "knip --directory ../.. --workspace apps/server",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio",
		"db:drop": "drizzle-kit drop",
		"db:seed": "bun run scripts/migrate-firebase-to-postgres.ts",
		"db:seed:dry": "bun run scripts/migrate-firebase-to-postgres.ts --dry-run",
		"db:migrate:run": "bun run scripts/migrate.ts",
		"db:migrate:deploy": "bun run scripts/migrate.ts",
		"provisioning:audit": "bun run scripts/user-provisioning-reconcile.ts audit",
		"provisioning:backfill": "bun run scripts/user-provisioning-reconcile.ts backfill",
		"push:backfill": "bun run scripts/backfill-push-tokens.ts",
		"woa:copy-subscriptions": "bun run scripts/copy-woa-subscriptions.ts",
		"postinstall": "bun run scripts/patch-effect-tsgo.ts",
		"typecheck": "bun run build",
		"fmt:check": "oxfmt --check",
		"emit-schema": "bun run scripts/emit-schema.ts"
	},
	"dependencies": {
		"@effect/opentelemetry": "4.0.5",
		"@effect/platform-bun": "4.0.5",
		"@effect/sql-pg": "4.0.5",
		"@envelop/sentry": "^16.0.0",
		"@graphql-yoga/plugin-apq": "^4.0.1",
		"@graphql-yoga/plugin-defer-stream": "^4.0.1",
		"@graphql-yoga/plugin-prometheus": "^7.0.1",
		"@graphql-yoga/plugin-response-cache": "^4.0.1",
		"@hccnj/castr": "workspace:*",
		"@hccnj/ccb": "workspace:*",
		"@hccnj/schema": "workspace:*",
		"@hccnj/strapi-v2": "workspace:*",
		"@hono/prometheus": "^1.0.3",
		"@hono/zod-openapi": "^1.6.3",
		"@js-temporal/polyfill": "^0.5.1",
		"@opentelemetry/api": "^1.9.1",
		"@opentelemetry/auto-instrumentations-node": "^0.81.2",
		"@opentelemetry/exporter-prometheus": "^0.223.0",
		"@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
		"@opentelemetry/resources": "^2.12.0",
		"@opentelemetry/sdk-logs": "^0.223.0",
		"@opentelemetry/sdk-metrics": "^2.12.0",
		"@opentelemetry/sdk-node": "^0.223.0",
		"@opentelemetry/sdk-trace-base": "^2.12.0",
		"@opentelemetry/sdk-trace-node": "^2.12.0",
		"@opentelemetry/sdk-trace-web": "^2.12.0",
		"@opentelemetry/semantic-conventions": "^1.44.0",
		"@pothos/core": "^4.16.0",
		"@pothos/plugin-directives": "^4.3.3",
		"@pothos/plugin-drizzle": "^0.20.2",
		"@pothos/plugin-errors": "^4.9.3",
		"@pothos/plugin-relay": "^4.8.1",
		"@pothos/plugin-scope-auth": "^4.2.2",
		"@pothos/plugin-simple-objects": "^4.1.4",
		"@pothos/plugin-tracing": "^1.1.4",
		"@pothos/plugin-with-input": "^4.1.5",
		"@pothos/tracing-sentry": "^1.1.5",
		"@scalar/hono-api-reference": "^0.12.18",
		"@sendgrid/mail": "^8.1.6",
		"@sentry/bun": "^11.11.0",
		"@statsig/statsig-node-core": "^0.24.0",
		"dataloader": "^2.2.3",
		"date-fns": "^4.4.0",
		"date-fns-tz": "^3.2.0",
		"drizzle-orm": "1.0.0-rc.5",
		"effect": "catalog:",
		"firebase-admin": "^14.5.0",
		"google-auth-library": "^11.3.3",
		"graphql": "17.1.0",
		"graphql-scalars": "^2.0.1",
		"graphql-yoga": "^6.0.1",
		"hono": "^4.13.16",
		"hono-rate-limiter": "^0.5.4",
		"lru-cache": "^11.5.3",
		"luxon": "^3.7.2",
		"node-vibrant": "^4.0.4",
		"pdf-lib": "^1.17.1",
		"pg": "^8.23.1",
		"pino": "^10.4.0",
		"prom-client": "^15.1.3",
		"stellate": "^3.2.32",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@effect/language-service": "^0.87.5",
		"@effect/sql-pglite": "4.0.5",
		"@effect/tsgo": "^0.45.0",
		"@electric-sql/pglite": "^0.5.15",
		"@hccnj/anti-slop": "workspace:*",
		"@hccnj/config": "workspace:*",
		"@ianvs/prettier-plugin-sort-imports": "^4.7.1",
		"@types/bun": "1.4.4",
		"@types/luxon": "^3.7.6",
		"@types/node": "^26.6.6",
		"@types/pg": "^8.20.0",
		"@typescript/native": "npm:typescript@^7.0.2",
		"drizzle-kit": "1.0.0-rc.5",
		"oxfmt": "^0.76.0",
		"oxlint": "catalog:",
		"oxlint-tsgolint": "catalog:",
		"prettier": "^3.9.10",
		"typescript": "^7.0.2"
	}
}
