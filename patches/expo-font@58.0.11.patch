diff --git a/ios/FontRegistry.swift b/ios/FontRegistry.swift
new file mode 100644
index 0000000000000000000000000000000000000000..2081087fbee341f4de505f521607aff2d5d2ed60
--- /dev/null
+++ b/ios/FontRegistry.swift
@@ -0,0 +1,34 @@
+import Foundation
+
+// Sync JS reads and async font loads run on different queues. Protect the
+// array and its deferred initialization with the same lock.
+internal final class FontRegistry: @unchecked Sendable {
+  private let lock = NSLock()
+  private let queryFonts: () -> [String]
+  private var fonts: [String]?
+
+  init(queryFonts: @escaping () -> [String]) {
+    self.queryFonts = queryFonts
+  }
+
+  func getLoadedFonts() -> [String] {
+    lock.lock()
+    defer { lock.unlock() }
+    return loadFontsWhileLocked()
+  }
+
+  func register(_ names: [String]) {
+    lock.lock()
+    defer { lock.unlock() }
+    fonts = Array(Set(loadFontsWhileLocked()).union(names))
+  }
+
+  private func loadFontsWhileLocked() -> [String] {
+    if let fonts {
+      return fonts
+    }
+    let loaded = queryFonts()
+    fonts = loaded
+    return loaded
+  }
+}
